#!/bin/bash --login
#SBATCH --array=1-35
#SBATCH --time=1:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=40G
#SBATCH --job-name BL_baseline_PC_and_SNP
#SBATCH --output=%x_%A_%a.out

cd /mnt/research/glbrc_group/shiulab/kenia

TRAITS=($(head -n 1 Shiu_Lab/Project/Data/Peter_2018/pheno.csv | sed 's/,/ /g'))
PIPE=Shiu_Lab/Project/Scripts/Genomic_Prediction_BL
DATA=Shiu_Lab/Project/Data/Peter_2018
save=/mnt/research/glbrc_group/shiulab/kenia/yeast_project/SNP_yeast_BL_results/baseline

echo "${TRAITS[${SLURM_ARRAY_TASK_ID}]}"

# PCs
# Rscript ${PIPE}/BL_Model.R ${DATA}/geno_PCs1.csv ${DATA}/pheno.csv all ${DATA}/Test.txt ${TRAITS[${SLURM_ARRAY_TASK_ID}]} ${DATA}/CVFs_20rep.csv 5 20 baseline_PCs_tassel_BL $save
Rscript ${PIPE}/BL_Model.R ${DATA}/PCs_first5.csv ${DATA}/pheno.csv all ${DATA}/Test.txt ${TRAITS[${SLURM_ARRAY_TASK_ID}]} ${DATA}/CVFs_20rep.csv 5 20 baseline_PCs_sklearn_BL $save

# Baseline SNPs
# Rscript ${PIPE}/BL_Model.R ${DATA}/geno.csv ${DATA}/pheno.csv all ${DATA}/Test.txt ${TRAITS[${SLURM_ARRAY_TASK_ID}]} ${DATA}/CVFs_20rep.csv 5 20 baseline_snp_BL $save

scontrol show job $SLURM_JOB_ID
