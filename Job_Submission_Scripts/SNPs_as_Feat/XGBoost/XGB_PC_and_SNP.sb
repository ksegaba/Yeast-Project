#    -save $save -tag PCs_tassel -fold 5 -n 20 -plot f
python ${PIPE}/1b_xgb_regression.py -X ${DATA}/PCs_first5.csv \
   -Y ${DATA}/pheno.csv \
   -test ${DATA}/Test.txt \
   -y_name ${TRAITS[${SLURM_ARRAY_TASK_ID}]} \
   -prefix ${TRAITS[${SLURM_ARRAY_TASK_ID}]}_PCs_sklearn_baseline \
   -save $save -tag PCs_sklearn -fold 5 -n 20 -plot f


# Baseline SNPs
